# Salin berkas ini menjadi `.env.local` (lokal) atau isi di Vercel (production).

# Koneksi PostgreSQL (Neon / Supabase). Contoh Neon:
# postgresql://user:password@ep-xxx.aws.neon.tech/mismada?sslmode=require
DATABASE_URL=

# Rahasia penandatanganan cookie sesi. Buat di terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
